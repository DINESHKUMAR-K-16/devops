pipeline {
    agent any
    stages {
        stage("Build stage") {
            steps {
                echo "Building project . . . . ."
            }
        }
        stage("Test stage") {
            steps {
                echo "Testing project . . . . ."
            }
        }
        stage("Deploy stage") {
            steps {
                echo "Deploying project . . . . ."
            }
        }
    }
    post {
        always {
            echo "Thank You"
        }
    }
}
